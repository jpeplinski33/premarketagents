# Private-image filename salt — NEVER commit. Knowing it lets anyone
# recompute every /images/p/<hash>.jpg URL from the original filenames.
# The docs/ copy is created by `rsync -a --delete site/ docs/`; it is ignored
# here so it can never reach the GitHub Pages deploy.
site/images/.private-salt
docs/images/.private-salt
